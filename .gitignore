node_modules/

# ZET dev-server TLS pair. key.pem is a real private key and must never be
# published; cert.pem is its partner and is useless alone. Both are
# localhost-only self-signed files — regenerate them locally, see README.
key.pem
cert.pem

# ZET tooling output
ZET-debug.log
*.log

.DS_Store
Thumbs.db
.vscode/

# Publish permalink keys. Each grants login-free read access to a
# component — organisation contacts, and applicant names/emails/phones.
# This repo is public, so they stay out of it. config.example.js is the
# committed template; zet pack still includes the real file.
app/js/config.js
